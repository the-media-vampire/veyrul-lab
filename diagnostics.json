      "symptom": "too much colour remains",
      "source_cause": "similarity too high",
      "source_fix": "lower similarity",
      "metric": "chroma_saturation_mean_outside_roi",
      "threshold": "> 0.15",
      "threshold_note": "illustrative; outside-ROI colour leaking through",
      "parameter": "similarity",
      "direction": "decrease",
      "step": 0.05
    },
    {
