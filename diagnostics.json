      "symptom": "speckled edges",
      "source_cause": "blend at 0",
      "source_fix": "raise blend a little",
      "metric": "edge_variance_in_roi_border",
      "threshold": "> 0.08",
      "threshold_note": "illustrative; high pixel-to-pixel variance at object edge",
      "parameter": "blend",
      "direction": "increase",
      "step": 0.05
    },
    {
      "id": "D4",
      "symptom": "colour name rejected or wrong colour held",
