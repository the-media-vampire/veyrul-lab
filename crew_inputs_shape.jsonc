{
  "name": "Outline Crew",
  "agents": ["outliner"],
  "tasks": [
    {
      "name": "outline_task",
      "description": "Write a three-beat outline for a {genre} story about: {premise}",
      "expected_output": "A markdown outline with three headed beats of two sentences each.",
      "agent": "outliner",
      "output_file": "output/outline.md",
      "markdown": true
    }
  ],
  "process": "sequential",
  "verbose": true,
  // inputs block: HYPOTHESIS — shape unconfirmed; verify against LLMs/quickstart docs
  "inputs": {
    "genre": "science fiction",
    "premise": "A solo deep-space miner discovers a signal that pre-dates human spaceflight"
  }
}