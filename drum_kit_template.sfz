// SFZ Drum Kit Template
// Structural template only. Replace sample= paths before loading.
// Source: Veyrul art_01M6QBKFBG0E8B1KC9NQBY5RJV r1

<global>
loop_mode=one_shot

// KICK - key 36 (GM C2), 4 vel layers x 4 round robins
<group>
key=36
seq_length=4

<region> lovel=0  hivel=31  amp_velcurve_31=1  seq_position=1  sample=kick/kick_pp_rr1.wav
